<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="2" author="eugeniy" context="!test">
        <!-- 1. Удаляем дубликаты: для каждого текста оставляем только запись с минимальным id -->
        <sql dbms="postgresql">
            DELETE FROM embeddings
            WHERE id NOT IN (
                SELECT MIN(id)
                FROM embeddings
                GROUP BY text
            );
        </sql>

        <!-- 2. Добавляем уникальное ограничение на колонку text -->
        <addUniqueConstraint
                tableName="embeddings"
                columnNames="text"
                constraintName="uk_embeddings_text"
                deferrable="false"
                initiallyDeferred="false"
        />
    </changeSet>

</databaseChangeLog>